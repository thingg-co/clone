# gpt-oss-120b on vLLM: 128k context is its ceiling, so this is for the
# tool-calling quality and the Anthropic-style endpoint, not for long context.
# ~65 GB (MXFP4 safetensors).
TITLE="gpt-oss-120b"
DETAIL="117B, 5B active, MXFP4, 65 GB"
HF_REPO=openai/gpt-oss-120b
SERVED_NAME=gpt-oss-120b
MAX_LEN=131072
LONG_MAX_LEN=
ROPE_ORIG=
TOOL_PARSER=openai
REASONING_PARSER=openai_gptoss
KV_DTYPE=auto
MEM_UTIL=0.85
MIN_FREE_GB=75
EXTRA_ARGS=""
