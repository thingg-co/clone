# NVIDIA Nemotron 3.5 Lightning 30B-A3B (August 2026). The model is trained
# for 1M (max_position_embeddings is 1048576), so nothing is stretched, NVIDIA
# validates 1M on the DGX Spark, and it is very fast: 124 to 136 tok/s here.
# It fails scripts/context-test.py all the same: with this profile on
# 2026-10-15, 2 of 3 codes at 89k and 1 of 3 from 253k to 991k. The window is
# there and the recall is not.
# Hybrid Mamba-2 / MoE with a few attention layers, 3B active. It reasons
# natively (nemotron_v3 parser) and calls tools (qwen3_coder parser). NVFP4
# weights are 22 GB; the DSpark draft model (1.3 GB) is NVIDIA's speculative
# decoding checkpoint for this box. Flags below are the model card's DGX Spark
# recipe. License: OpenMDW-1.1.
TITLE="Nemotron 3.5 Lightning"
DETAIL="30B, 3B active, NVFP4, 22 GB"
HF_REPO=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
EXTRA_REPOS=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
SERVED_NAME=nemotron-3.5-lightning
MAX_LEN=1048576
LONG_MAX_LEN=
ROPE_ORIG=
TOOL_PARSER=qwen3_coder
REASONING_PARSER=nemotron_v3
# Full precision. vLLM warns that the FP8 cache is uncalibrated for this
# checkpoint, and the cache is tiny here (6 attention layers).
KV_DTYPE=auto
# The card uses 0.85. 0.60 of 121.7 GiB is 73 GiB, which is already far more
# than 22 GB of weights and a 1M-token cache need, and leaves the rest free.
MEM_UTIL=0.60
MIN_FREE_GB=75
EXTRA_ARGS="--moe-backend marlin --mamba-backend flashinfer --mamba-cache-mode align --speculative_config.num_speculative_tokens 3 --speculative_config.model nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark"
