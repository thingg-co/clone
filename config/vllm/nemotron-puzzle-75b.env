# NVIDIA Nemotron-Labs-3-Puzzle-75B-A9B (June 2026), NVFP4: Nemotron 3 Super cut down by
# NVIDIA's Iterative Puzzle (experts and Mamba layers pruned, attention kept) to 75B with
# 9B active, then distilled at long context to win back what the cuts cost. The card
# reports RULER 94-95% at 512k and 92-93% at 1M, where Super itself failed this box's
# recall test early. Its config says 256k; the card says the model takes 1M, and the
# attention layers carry no position encoding to stretch. 54 GB with the MTP head. The
# parsers and the Mamba cache settings are the card's. License: OpenMDW-1.1.
TITLE="Nemotron-Labs-3 Puzzle 75B"
DETAIL="75B, 9B active, NVFP4, 54 GB"
HF_REPO=nvidia/NVIDIA-Nemotron-Labs-3-Puzzle-75B-A9B-NVFP4
SERVED_NAME=nemotron-puzzle-75b
MAX_LEN=1000000
LONG_MAX_LEN=
ROPE_ORIG=
TOOL_PARSER=qwen3_coder
REASONING_PARSER=nemotron_v3
# The attention layers are Super's: about 8 GiB of 16-bit cache for a million tokens.
KV_DTYPE=auto
# 0.70 of 121.7 GiB is 85 GiB: 50 for weights, the rest for cache, Mamba state and activations.
MEM_UTIL=0.70
MIN_FREE_GB=88
DOCKER_ENV="VLLM_NVFP4_GEMM_BACKEND=marlin VLLM_USE_FLASHINFER_MOE_FP4=0"
EXTRA_ARGS="--trust-remote-code --async-scheduling --enable-chunked-prefill --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5"
