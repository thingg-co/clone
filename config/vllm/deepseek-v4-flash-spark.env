# DeepSeek V4 Flash 0731 in 0xSero's build for one DGX Spark: the experts pruned (REAP),
# 3-bit EXL3 weights, 107 GB, served by a patched vLLM with the sparkinfer kernels and
# DeepSeek's DSpark speculative decoding. Validated at 262k tokens, which is under the 500k
# floor; it is here for its speed and to compare how it reads with the GGUF builds.
# spark/deepseek-spark.sh fetches, prepares and serves it; see its header.
TITLE="DeepSeek V4 Flash, single-Spark build"
DETAIL="284B with pruned experts, 3-bit EXL3, 107 GB, DSpark draft"
HF_REPO=0xSero/deepseek-v4-flash-0731-spark
SERVED_NAME=deepseek-v4-flash-spark
MAX_LEN=262144
TOOL_PARSER=deepseek_v4
REASONING_PARSER=deepseek_v4
KV_DTYPE=nvfp4_ds_mla
MEM_UTIL=0.9465
MIN_FREE_GB=100
RUNNER=spark/deepseek-spark.sh
PULL="spark/deepseek-spark.sh fetch"
PREPARE="spark/deepseek-spark.sh prepare"
