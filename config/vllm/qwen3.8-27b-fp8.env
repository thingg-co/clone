# Qwen3.8-27B with the FP8 cache that NVIDIA's recipe for the checkpoint uses,
# which makes room for the model card's full 1.01M window. Same weights as
# qwen3.8-27b, and the same notes apply. An experiment until
# scripts/context-test.py has passed on it: the results in the README were
# measured with the 16-bit cache.
TITLE="Qwen3.8-27B, FP8 cache"
DETAIL="dense 27B, NVFP4, 22 GB"
HF_REPO=nvidia/Qwen3.8-27B-NVFP4
SERVED_NAME=qwen3.8-27b
MAX_LEN=262144
LONG_MAX_LEN=1010000
ROPE_ORIG=262144
ROPE_STYLE=qwen35
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EFFORT_ALIAS=1
# About 33 KB per token at FP8, so 0.68 of 121.7 GiB holds 1.8M tokens of
# cache: room for a prompt that fills the window, which the 16-bit pool lacks.
KV_DTYPE=fp8_e4m3
MEM_UTIL=0.68
MIN_FREE_GB=84
EXTRA_ARGS="--max-num-batched-tokens 32768"
