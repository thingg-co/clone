# NVIDIA Nemotron 3 Super 120B-A12B (March 2026), NVFP4. Same hybrid Mamba-2 /
# MoE family as Lightning but four times the size, with 12B active, and the
# card reports long-context retrieval holding up as the prompt grows (RULER
# 96% at 128k, 256k and 512k). scripts/context-test.py disagrees on this box:
# 2 of 3 codes at 93k, 1 of 3 at 235k and 489k. 16 tok/s.
# NVIDIA lists one DGX Spark as the minimum machine. Weights are 80 GB.
# Reasoning can be switched per request (enable_thinking); tools use the
# qwen3_coder parser. The reasoning parser ships in the model repo as a plugin.
# Flags and environment below are the card's DGX Spark recipe. License: NVIDIA
# Open Model License (see the card).
HF_REPO=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
SERVED_NAME=nemotron-3-super
MAX_LEN=1000000
LONG_MAX_LEN=
ROPE_ORIG=
TOOL_PARSER=qwen3_coder
REASONING_PARSER=super_v3
REASONING_PLUGIN=super_v3_reasoning_parser.py
# Full-precision cache: 8 attention layers with 2 KV heads of 128 is 8 KB per
# token at 16 bits, so a million tokens is under 8 GiB. No reason to quantise.
KV_DTYPE=auto
# The card uses 0.90. 0.78 of 121.7 GiB is 95 GiB: 75 for weights and 20 for
# cache and activations, and it leaves the OS its 10.
MEM_UTIL=0.78
MIN_FREE_GB=96
DOCKER_ENV="VLLM_NVFP4_GEMM_BACKEND=marlin VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm VLLM_USE_FLASHINFER_MOE_FP4=0"
EXTRA_ARGS="--trust-remote-code --async-scheduling --enable-chunked-prefill"
