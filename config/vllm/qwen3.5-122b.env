# Qwen3.5-122B-A10B (February 2026), NVIDIA's NVFP4 build: 122B with 10B
# active, 84 GB, Apache-2.0. The largest member of the family whose stretched
# window has tested exact, and the one that uses most of this machine. It
# thinks by default (qwen3 reasoning parser) and calls tools (qwen3_coder
# parser). 256k natively; VLLM_LONG stretches it with the YaRN setting from
# Qwen's card.
TITLE="Qwen3.5-122B-A10B"
DETAIL="122B, 10B active, NVFP4, 84 GB"
HF_REPO=nvidia/Qwen3.5-122B-A10B-NVFP4
SERVED_NAME=qwen3.5-122b
MAX_LEN=262144
LONG_MAX_LEN=500000
ROPE_ORIG=262144
ROPE_STYLE=qwen35
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
# 16-bit cache. 12 of 48 layers are full attention with 2 KV heads of 256:
# about 25 KB per token. After 78 GiB of weights, 0.78 of 121.7 GiB leaves
# about 14 GiB of cache, which is 570k tokens, so the window stops at 500k to
# keep headroom over a prompt that fills it. qwen3.5-122b-fp8 trades cache
# precision for the full 1.01M.
KV_DTYPE=auto
MEM_UTIL=0.78
MIN_FREE_GB=96
EXTRA_ARGS="--trust-remote-code --moe-backend marlin --max-num-batched-tokens 8192 --enable-chunked-prefill"
