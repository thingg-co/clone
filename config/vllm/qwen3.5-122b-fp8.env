# Qwen3.5-122B-A10B with the FP8 cache that NVIDIA's recipe for the checkpoint
# uses, which halves the cost per token and makes room for the card's full
# 1.01M window. Same weights as qwen3.5-122b, and the same notes apply.
TITLE="Qwen3.5-122B-A10B, FP8 cache"
DETAIL="122B, 10B active, NVFP4, 84 GB"
HF_REPO=nvidia/Qwen3.5-122B-A10B-NVFP4
SERVED_NAME=qwen3.5-122b
MAX_LEN=262144
LONG_MAX_LEN=1010000
ROPE_ORIG=262144
ROPE_STYLE=qwen35
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
# About 12 KB per token at FP8, so the 14 GiB left after the weights hold
# 1.1M tokens.
KV_DTYPE=fp8_e4m3
MEM_UTIL=0.78
MIN_FREE_GB=96
EXTRA_ARGS="--trust-remote-code --moe-backend marlin --max-num-batched-tokens 8192 --enable-chunked-prefill"
