# DeepSeek V4 Flash 0731: 284B MoE, 13B active, trained to a 1M window.
# Its attention keeps a compressed cache (one entry per 4 or 128 tokens in most
# layers), so a full window costs a few GiB where a dense model needs tens.
# The release weights are 167 GB and do not load on one Spark. This is
# Unsloth's 3-bit build, 104 GB, the highest precision that leaves room for
# the cache. V4.1 Flash (September) is 510 GB and has no build that fits.
TITLE="DeepSeek V4 Flash"
DETAIL="284B, 13B active, 3-bit GGUF, 104 GB"
HF_REPO=unsloth/DeepSeek-V4-Flash-0731-GGUF
HF_INCLUDE="*UD-IQ3_XXS*"
GGUF_MATCH="UD-IQ3_XXS"
ALIAS=deepseek-v4-flash
CTX=fit                     # start from the trained 1M and shrink only if it does not fit
CTX_MIN=262144
KV_TYPE=f16
MIN_FREE_GB=104
# dio reads the file without filling the page cache, which the GPU needs for itself.
# --cache-ram 0 keeps llama-server from holding saved prompts in host memory, and a
# four-hour timeout leaves room to read a million-token prompt.
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
# Its template adds an instruction to reason at length only when asked for high or max.
TEMPLATE_KWARGS='{"reasoning_effort":"max"}'
