# Clef (Cloudflare, September 2026): a decision model on Qwen3.8-27B. It answers typed
# questions (yes or no, one of several options, a score) about a passage in one pass and
# writes no text, so it cannot be the main model; a server running it only answers
# /v1/systemone. llama.cpp reads Clef's whole prompt in one batch, so the batch size is
# the longest passage it can judge. scripts/clef-test.py measures it as a checker.
TITLE="Clef"
DETAIL="decision model on Qwen3.8-27B, 8-bit GGUF, 29 GB"
KIND=decision
HF_REPO=ggml-org/Clef-GGUF
HF_INCLUDE="Clef-Q8_0.gguf"
GGUF_MATCH="Clef-Q8_0"
ALIAS=clef
CTX=131072
BATCH=131072
UBATCH=131072
KV_TYPE=f16
MIN_FREE_GB=60
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400"
