# NVIDIA Nemotron-Cascade-2 30B-A3B (March 2026): hybrid Mamba-2 / MoE with 3B active, the
# same shape as Lightning with different post-training. The card claims a 1M window and
# shows needle-in-a-haystack results at 1M. At 8 bits it is 34 GB, a cheap check.
# NVIDIA Open Model License.
TITLE="Nemotron-Cascade-2 30B-A3B"
DETAIL="30B, 3B active, 8-bit GGUF, 34 GB"
HF_REPO=bartowski/nvidia_Nemotron-Cascade-2-30B-A3B-GGUF
HF_INCLUDE="*Q8_0*"
GGUF_MATCH="Q8_0"
ALIAS=nemotron-cascade-2
CTX=fit
CTX_MIN=262144
FIT_MARGIN_MB=8192
KV_TYPE=f16
MIN_FREE_GB=40
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
