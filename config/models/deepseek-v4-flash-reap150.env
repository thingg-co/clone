# DeepSeek V4 Flash 0731 with 132 of its 256 experts per layer kept (REAP pruning, by
# puwaer), about 150B, still 13B active. The experts stay in DeepSeek's own FP4 (MXFP4), so
# nothing is requantized, and at 85 GB it leaves more room for the cache than the 104 GB
# 3-bit build of the whole model. The card reports code and math scores matching the full
# model at 4k tokens; nobody has published a long-context test. Template embedded. MIT.
TITLE="DeepSeek V4 Flash, REAP 150B"
DETAIL="150B of 284B kept, 13B active, FP4 experts, 85 GB"
HF_REPO=puwaer/DeepSeek-V4-Flash-0731-reap-150b-gguf
HF_INCLUDE="*MXFP4_MOE*"
GGUF_MATCH="MXFP4_MOE"
ALIAS=deepseek-v4-flash-reap150
CTX=fit
CTX_MIN=262144
FIT_MARGIN_MB=8192
KV_TYPE=f16
MIN_FREE_GB=88
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
