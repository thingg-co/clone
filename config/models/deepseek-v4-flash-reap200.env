# DeepSeek V4 Flash 0731 with 178 of its 256 experts per layer kept (REAP, by puwaer),
# about 200B, 13B active. The card reports the same pass@1 as the full model on 542 code
# problems. Kept in FP4 it is 112 GB, too much here, so this is the 3-bit requantization,
# 93 GB: more of the model than the REAP 150B build, at lower precision. MIT.
TITLE="DeepSeek V4 Flash, REAP 200B"
DETAIL="200B of 284B kept, 13B active, 3-bit GGUF, 93 GB"
HF_REPO=puwaer/DeepSeek-V4-Flash-0731-reap-200b-gguf
HF_INCLUDE="*Q3_K_M*"
GGUF_MATCH="Q3_K_M"
ALIAS=deepseek-v4-flash-reap200
CTX=fit
CTX_MIN=262144
FIT_MARGIN_MB=8192
KV_TYPE=f16
MIN_FREE_GB=95
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
