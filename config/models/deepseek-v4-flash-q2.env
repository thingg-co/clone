# DeepSeek V4 Flash 0731 at about 2.7 bits per weight (Unsloth UD-Q2_K_XL, 97 GB), next
# to the 3-bit deepseek-v4-flash in the same folder. Measured to see what the extra
# precision buys in recall, and what the 7 GB it saves buys in window.
TITLE="DeepSeek V4 Flash, 2-bit"
DETAIL="284B, 13B active, 2-bit GGUF, 97 GB"
HF_REPO=unsloth/DeepSeek-V4-Flash-0731-GGUF
HF_INCLUDE="*UD-Q2_K_XL*"
GGUF_MATCH="UD-Q2_K_XL"
MODEL_DIR=deepseek-v4-flash
ALIAS=deepseek-v4-flash-q2
CTX=fit
CTX_MIN=262144
FIT_MARGIN_MB=8192
KV_TYPE=f16
MIN_FREE_GB=98
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
# Its template adds an instruction to reason at length only when asked for high or max.
TEMPLATE_KWARGS='{"reasoning_effort":"max"}'
