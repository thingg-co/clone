# K2-Horizon MoVA 36B-A4B (IFM, September 2026): 36B MoE, 4B active, trained natively to
# a 512k window. Every attention layer keeps a full cache, so 512k tokens take about 55 GB
# at 8 bits and prompts read slowly. Its tool-call format needs a llama.cpp parser fix that
# was still open in October (PR 30335), so tool calls may not come back parsed. Apache-2.0.
TITLE="K2-Horizon MoVA 36B-A4B"
DETAIL="36B, 4B active, 8-bit GGUF, 40 GB"
HF_REPO=IFM/K2-Horizon-MoVA-36B-A4B-GGUF
HF_INCLUDE="*Q8_0*"
GGUF_MATCH="Q8_0"
ALIAS=k2-horizon-mova
CTX=fit
CTX_MIN=262144
FIT_MARGIN_MB=8192
KV_TYPE=q8_0
MIN_FREE_GB=45
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
