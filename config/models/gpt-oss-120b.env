# gpt-oss-120b: 117B MoE, 5.1B active, shipped in MXFP4 so no quantisation loss.
# ~63 GB on disk. Best tool caller that still leaves ~60 GB for context and a
# second model. This is the default.
HF_REPO=ggml-org/gpt-oss-120b-GGUF
HF_INCLUDE="gpt-oss-120b-MXFP4*.gguf"
GGUF_MATCH="gpt-oss-120b-MXFP4"
ALIAS=gpt-oss-120b
CTX=131072                  # per slot; the model's max
KV_TYPE=f16                 # KV is tiny on this model (sliding-window layers), no need to quantise
MIN_FREE_GB=68              # serve.sh refuses to start with less MemAvailable unless FORCE=1
# reasoning_effort here is the server default; the agent overrides it per request
EXTRA_ARGS="--reasoning-format auto --chat-template-kwargs {\"reasoning_effort\":\"high\"}"
