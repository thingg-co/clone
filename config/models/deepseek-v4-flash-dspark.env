# The 2-bit DeepSeek V4 Flash with DSpark, DeepSeek's own draft model for speculative
# decoding (11 GB at 8-bit): the draft guesses several tokens and the main model checks
# them in one pass, which DeepSeek puts at up to twice the decode speed. The answers are
# the main model's either way. The draft's memory comes out of the window.
TITLE="DeepSeek V4 Flash, 2-bit with DSpark"
DETAIL="284B, 13B active, 2-bit GGUF and an 8-bit draft, 108 GB"
HF_REPO=unsloth/DeepSeek-V4-Flash-0731-GGUF
HF_INCLUDE="*UD-Q2_K_XL* dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf"
GGUF_MATCH="UD-Q2_K_XL"
MODEL_DIR=deepseek-v4-flash
ALIAS=deepseek-v4-flash-dspark
CTX=fit
CTX_MIN=131072
FIT_MARGIN_MB=20480         # 8 GiB for the machine, 12 more in case the fit leaves the draft out
KV_TYPE=f16
MIN_FREE_GB=108
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto --spec-type draft-dspark -md $MODELS_DIR/deepseek-v4-flash/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf -ngld 999"
