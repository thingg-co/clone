# Seed-OSS-36B-Instruct (ByteDance, August 2025): dense 36B trained to a 512k window,
# with a thinking budget in its template. A dense model's cache is large, 256 KiB per
# token at 16 bits, so an 8-bit cache is what lets the window fit beside the weights.
TITLE="Seed-OSS-36B"
DETAIL="dense 36B, 8-bit GGUF, 38 GB"
HF_REPO=unsloth/Seed-OSS-36B-Instruct-GGUF
HF_INCLUDE="Seed-OSS-36B-Instruct-Q8_0.gguf"
GGUF_MATCH="Q8_0"
ALIAS=seed-oss-36b
CTX=fit                     # start from the trained 512k and shrink only if it does not fit
CTX_MIN=131072
KV_TYPE=q8_0
MIN_FREE_GB=50
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400 --reasoning on --reasoning-format auto"
