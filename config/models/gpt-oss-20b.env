# gpt-oss-20b: 21B MoE, 3.6B active, MXFP4, ~12 GB. Fast sidekick, and the one
# to run while something else is hogging memory. Tool calling is solid for its size.
HF_REPO=ggml-org/gpt-oss-20b-GGUF
HF_INCLUDE="gpt-oss-20b-MXFP4*.gguf"
GGUF_MATCH="gpt-oss-20b-MXFP4"
ALIAS=gpt-oss-20b
CTX=131072
KV_TYPE=f16
MIN_FREE_GB=16
EXTRA_ARGS="--reasoning-format auto"
# The template defaults to medium; high is the deepest it has.
TEMPLATE_KWARGS='{"reasoning_effort":"high"}'
