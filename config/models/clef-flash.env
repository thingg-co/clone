# Clef-Flash: the small Clef, on Qwen3.5-9B (10 GB at 8-bit). Five times faster than Clef
# on Cloudflare's numbers, but much weaker at spotting unsupported claims (36 against 79
# F1 on RAGTruth). Measured with the same checker test.
TITLE="Clef-Flash"
DETAIL="decision model on Qwen3.5-9B, 8-bit GGUF, 10 GB"
KIND=decision
HF_REPO=ggml-org/Clef-Flash-GGUF
HF_INCLUDE="Clef-Flash-Q8_0.gguf"
GGUF_MATCH="Clef-Flash-Q8_0"
ALIAS=clef-flash
CTX=65536
BATCH=65536
UBATCH=65536
KV_TYPE=f16
MIN_FREE_GB=50
EXTRA_ARGS="--load-mode dio --cache-ram 0 --timeout 14400"
