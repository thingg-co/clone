# Qwen3-235B-A22B-Instruct-2507: the "use the whole box" option. Unsloth
# UD-Q3_K_XL is ~104 GB; with q8 KV at 64k context it just fits in 128 GB with
# nothing else running. 22B active params at 273 GB/s means roughly 10 tok/s.
# Worth it for hard reasoning, not for interactive coding.
HF_REPO=unsloth/Qwen3-235B-A22B-Instruct-2507-GGUF
HF_INCLUDE="*UD-Q3_K_XL*"
GGUF_MATCH="UD-Q3_K_XL"
ALIAS=qwen3-235b
CTX=65536
KV_TYPE=q8_0
MIN_FREE_GB=112
EXTRA_ARGS="--reasoning-format none"
