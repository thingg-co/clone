# Copy to config/spark.env (gitignored) and edit. Sourced by spark/*.sh on the
# Spark and by scripts/*.sh and the Makefile on the Mac. Plain KEY=VALUE, no spaces.

# --- Mac side: how to reach the Spark ---
SPARK_HOST=omega.local
SPARK_USER=alex
REMOTE_DIR=clone            # relative to $HOME on the Spark; this tree is synced there

# --- Spark side: what to serve ---
# Two backends share PORT; run one at a time on it.
#   llama.cpp (spark/serve.sh, GGUF profiles in config/models/): simple, 128k to 256k context
#   vLLM (spark/vllm.sh, profiles in config/vllm/): long context, up to 1M tokens
BACKEND=vllm                # vllm | llama
MODEL=gpt-oss-120b          # llama.cpp profile (config/models/)
VLLM_PROFILE=qwen3.8-27b   # vLLM profile (config/vllm/); the one that passes the recall test past 500k
VLLM_LONG=1                 # 0: the profile's native window. A token count or 1: stretch with YaRN, where the profile allows it
PORT=8080
API_KEY=change-me           # bearer token the agent and Claude Code send; any string
SLOTS=1                     # parallel request slots; each slot gets CTX tokens of context

# Optional second instance: a small fast model for subagents and quick tasks.
# Off by default. The Spark reports 121.7 GiB; a Qwen3-Next profile reserves 97
# of them (MEM_UTIL=0.80) and the OS takes about 10, which leaves no room for
# the sidekick's 14.5. Uncomment only with a smaller main profile, or after
# lowering MEM_UTIL and the context length to make room.
# SIDEKICK_MODEL=gpt-oss-20b
# SIDEKICK_PORT=8081

# Control page (spark/panel.py). 0.0.0.0 serves it on the LAN with no login;
# 127.0.0.1 keeps it to the SSH tunnel.
PANEL_HOST=0.0.0.0

# --- Optional overrides ---
# PANEL_PORT=8088                      # control page (spark/panel.py)
# MODELS_DIR=/home/alex/clone/models   # default: <this tree>/models
# LLAMA_DIR=/home/alex/clone/llama.cpp # default: <this tree>/llama.cpp
# LLAMA_REF=master                     # git ref to build; pin a tag (b7xxx) once something works
# LLAMA_EXTRA="--no-mmap"              # appended to every llama-server command
# VLLM_ROPE_FLAG=rope-scaling         # older vLLM: pass YaRN as --rope-scaling instead of --hf-overrides
# CUDA_ARCHS=121                       # GB10 is sm_121; set to native if cmake complains
