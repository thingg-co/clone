# systemd user unit for fable's chat page (bin/clone --web), on the sessions the clone
# command keeps. Like the control page it starts at boot and needs no model: until a
# model server is up it says so on the page. It listens where PANEL_HOST says.
[Unit]
Description=fable chat page
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=@ROOT@/bin/clone --web
Restart=on-failure
RestartSec=5
Environment=PATH=@ROOT@/.tools/bin:%h/.local/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
