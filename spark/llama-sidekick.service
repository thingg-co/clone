# systemd user unit for the optional small fast model.
# Like the main unit: never enabled, never restarted automatically.
[Unit]
Description=llama-server sidekick (frank)
After=network-online.target llama-server.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/env bash @ROOT@/spark/serve.sh sidekick
Restart=no
KillSignal=SIGINT
TimeoutStopSec=60
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
